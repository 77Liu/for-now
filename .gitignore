data/*
!data/.gitkeep
node_modules/
.DS_Store
.secrets/

# 本地工具与隔离工作现场，不作为项目源文件提交。
.superpowers/
.worktrees/

# 编译、打包和覆盖率产物；源码与配置仍按规则提交。
.build/
# 运维 TS 的 .mjs 仅供本机/部署运行，严禁作为源码提交。
.build/typescript/monitor/
dist/
coverage/
*.tsbuildinfo

# 仅忽略明确标记为生成的报告。控制面、发布证据和审计记录仍由 reports/ 下的已跟踪文件维护。
reports/generated/
reports/local/
reports/*.generated.*
reports/**/*.generated.*

# 正式版本事件与收口归档必须可跟踪；运行锁和原子写临时文件不入库。
!reports/iterations/
!reports/iterations/*/
!reports/iterations/*/events.jsonl
!reports/iterations/*/terminal.json
reports/iterations/.control-plane.lock
reports/requirement-coordination-current.json.tmp.*
reports/iterations/*/terminal.json.tmp.*

# TS 运行候选由 build:runtime 组装；这些路径只保留本地/部署产物，不进入 Git。
src/shared/record-compression-config.mjs
public/generated/

deploy/*.local
reports/keepsake-segmentation-preview/
.xcode-home/
.xcode-cache/
.xcode-packages/
build/ios-*/
.ab/
artifacts/
