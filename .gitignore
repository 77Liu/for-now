data/*
!data/.gitkeep
node_modules/
.DS_Store
.secrets/

# 本地工具与隔离工作现场，不作为项目源文件提交。
.superpowers/
.worktrees/

# 编译、打包和覆盖率产物；源码与配置仍按规则提交。
.build/
# 运维 TS 的 .mjs 仅供本机/部署运行，严禁作为源码提交。
.build/typescript/monitor/
dist/
coverage/
*.tsbuildinfo

# reports 只保存本地临时材料；正式状态、版本资料、审计和长期知识使用各自目录。
reports/

# 正式协调记录可跟踪；运行锁和原子写临时文件不入库。
coordination/.control-plane.lock
coordination/current.json.tmp.*
coordination/versions/*/terminal.json.tmp.*

# TS 运行候选由 build:runtime 组装；这些路径只保留本地/部署产物，不进入 Git。
src/shared/record-compression-config.mjs
public/generated/

deploy/*.local
.xcode-home/
.xcode-cache/
.xcode-packages/
build/ios-*/
.ab/
artifacts/
