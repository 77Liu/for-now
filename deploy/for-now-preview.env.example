# Install as /etc/for-now-preview.env with owner root:root and mode 0600.
NODE_ENV=production
PORT=4175
TZ=Asia/Shanghai
DATA_DIR=/srv/for-now-preview/data
APP_BASE_PATH=/preview
APP_VERSION=replace-at-deploy
INCREMENTAL_SYNC_ENABLED=1
PROMPT_CATALOG_VERSION=

# Preview owns an independent JSON/auth/data boundary.
PERSISTENCE_BACKEND=json
ATTACHMENT_STORAGE=local
AUTH_REQUIRED=1
COOKIE_SECURE=1
# Replace with the lowercase SHA-256 digest of a Preview-only invitation.
INVITE_CODE_HASH=

# Keep unattended work disabled in Preview unless a reviewed test needs it.
PERIODIC_ANALYSIS_ENABLED=0
SPEECH_CACHE_SWEEP_ENABLED=0

# Preview-specific provider credentials are optional and must not be copied
# implicitly from /etc/for-now.env.
DEEPSEEK_API_KEY=
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_PROJECT_NAME=default
VOLCENGINE_TTS_DEFAULT_VOICE=zh_male_shaonianzixin_uranus_bigtts
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_SESSION_TOKEN=
ALIBABA_CLOUD_ECS_RAM_ROLE=
ALIBABA_CLOUD_IMDSV1_DISABLED=true

# Conservative Preview limits. Provider calls still use the credentials above.
AI_GLOBAL_QPS=5
AI_GLOBAL_CONCURRENCY=5
AI_USER_DAILY_CALL_LIMIT=50
AI_COST_CNY_PER_USD=7.2
AI_USER_DAILY_COST_LIMIT_CNY=5
SEGMENTATION_GLOBAL_QPS=2
SEGMENTATION_GLOBAL_CONCURRENCY=2
SPEECH_GLOBAL_QPS=2
SPEECH_GLOBAL_CONCURRENCY=2
OCR_GLOBAL_QPS=2
OCR_GLOBAL_CONCURRENCY=2
DOCUMENT_PARSE_GLOBAL_QPS=1
DOCUMENT_PARSE_GLOBAL_CONCURRENCY=1
ATTACHMENT_USER_QUOTA_BYTES=268435456
