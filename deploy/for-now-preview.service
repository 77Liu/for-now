[Unit]
Description=For Now isolated preview
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=for-now-preview
Group=for-now-preview
WorkingDirectory=/opt/for-now-preview/app
EnvironmentFile=/etc/for-now-preview.env
ExecStart=/usr/local/bin/node server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/for-now-preview/data
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=for-now-preview

[Install]
WantedBy=multi-user.target
