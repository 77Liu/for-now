# Installed as /etc/for-now.env with mode 0600.
NODE_ENV=production
PORT=4173
TZ=Asia/Shanghai
DATA_DIR=/srv/for-now/data
APP_BASE_PATH=/now
APP_VERSION=replace-at-deploy
# Set to 0 to fall back to write-followed-by-refresh without incremental polling.
INCREMENTAL_SYNC_ENABLED=1
# Optional immutable prompt version. Empty uses prompts/manifest.json activeVersion.
PROMPT_CATALOG_VERSION=
AUTH_REQUIRED=1
# Periodic synthesis is opt-in. Manual review remains available while this is 0.
PERIODIC_ANALYSIS_ENABLED=0

# JSON remains the default until the offline migration/cutover is approved.
# PostgreSQL requires distinct non-owner data/auth/AI-budget roles in the same database.
PERSISTENCE_BACKEND=json
DATABASE_URL=
AUTH_DATABASE_URL=
AI_BUDGET_DATABASE_URL=
# Read-only recovery role with SELECT in both schemas; required for PG backups.
PG_BACKUP_DATABASE_URL=

# SHA-256 only. Never put the invitation plaintext in this file or Git.
INVITE_CODE_HASH=

# SHA-256 of the independent platform service token. The plaintext belongs only
# in /etc/for-now-platform.env and must be at least 32 random characters.
PLATFORM_SERVICE_TOKEN_HASH=

# The cloud service is only exposed through HTTPS.
COOKIE_SECURE=1

# Enable only after the PostgreSQL audit/usage migration and role grants pass.
AI_AUDIT_DB_ENABLED=0
AI_AUDIT_RETENTION_DAYS=30
AI_AUDIT_TEXT_LIMIT=1000000
AI_GLOBAL_QPS=20
AI_GLOBAL_CONCURRENCY=20
AI_USER_DAILY_CALL_LIMIT=200
AI_COST_CNY_PER_USD=7.2
# Set to 0 to disable cost-based rejection. Usage accounting remains enabled.
AI_USER_DAILY_COST_LIMIT_CNY=14.4
SEGMENTATION_GLOBAL_QPS=5
SEGMENTATION_GLOBAL_CONCURRENCY=5
# Canonical production defaults to enabled; set to 0 for an intentional pause.
SPEECH_CACHE_SWEEP_ENABLED=1
SPEECH_GLOBAL_QPS=5
SPEECH_GLOBAL_CONCURRENCY=5
OCR_GLOBAL_QPS=10
OCR_GLOBAL_CONCURRENCY=10
DOCUMENT_PARSE_GLOBAL_QPS=2
DOCUMENT_PARSE_GLOBAL_CONCURRENCY=2
ATTACHMENT_USER_QUOTA_BYTES=1073741824

# Volcengine Speech API Key. Keep the real value only in /etc/for-now.env.
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_PROJECT_NAME=default
# 默认整文件HTTP极速版；streaming仅保留显式选用，不自动付费回退。
VOLCENGINE_ASR_MODE=file
# 留空沿用provider内的官方整文件HTTP端点。
VOLCENGINE_ASR_FILE_ENDPOINT=
VOLCENGINE_TTS_DEFAULT_VOICE=zh_male_shaonianzixin_uranus_bigtts

# Volcengine Visual AK/SK. Prefer a least-privilege IAM user over the root account.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
# Optional when using temporary STS credentials.
VOLCENGINE_SESSION_TOKEN=

# Optional on ECS. Uses the instance RAM role instead of long-lived AccessKeys.
ALIBABA_CLOUD_ECS_RAM_ROLE=ForNowEcsBackupRole
ALIBABA_CLOUD_IMDSV1_DISABLED=true

# Production attachments are private OSS objects served through the authenticated app.
ATTACHMENT_STORAGE=oss
OSS_ATTACHMENT_BUCKET=for-now
OSS_ATTACHMENT_PREFIX=for-now-attachments

# Feishu custom-bot webhook. Keep both values only in /etc/for-now.env.
FEISHU_ALERT_WEBHOOK=
FEISHU_ALERT_SECRET=

# 此模板默认关闭日压缩及其时段通知。
# 启用后，全局上限为每天 4 元、每次 1 元、每天 16 次，每轮最多回填 4 天。
# 每个账户另有每日 2 次调用的队列额度，与全局上限分开计算。
RECORD_COMPRESSION_NOTIFICATIONS_ENABLED=0
RECORD_COMPRESSION_ENABLED=0
RECORD_COMPRESSION_DAILY_BUDGET_CNY=4
RECORD_COMPRESSION_PER_CALL_BUDGET_CNY=1
RECORD_COMPRESSION_DAILY_INVOCATION_LIMIT=16
RECORD_COMPRESSION_MAX_BACKFILL_DATES_PER_SCAN=4
# 留空使用唯一config默认起点；所有日摘要与历史补充共用这个日期边界。
RECORD_COMPRESSION_START_DATE=
ALERT_DISK_WARNING_PERCENT=70
ALERT_DISK_CRITICAL_PERCENT=85
ALERT_BACKUP_MAX_AGE_HOURS=26
ALERT_AI_CONSECUTIVE_FAILURES=5
ALERT_DAILY_AI_COST_CNY=36
ALERT_REPEAT_MINUTES=60
MONITOR_PLATFORM_ENABLED=0
MONITOR_PLATFORM_SERVICE_NAME=for-now-platform.service
MONITOR_PLATFORM_READY_URL=http://127.0.0.1:4280/readyz

# Optional local-development mode. Leave empty on the cloud server.
# UPSTREAM_ORIGIN=https://77liu.top/now

OSS_DESTINATION=oss://for-now/for-now-backups
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_REGION=cn-beijing

# V0.5.9: default authenticated proxy; only immutable thumb/display/TTS derivatives.
# Keep bucket/endpoint when rolling back to proxy so permanent deletion cleans replicas.
MEDIA_DELIVERY_MODE=proxy
MEDIA_DELIVERY_BUCKET=
MEDIA_DELIVERY_OSS_ENDPOINT=
MEDIA_CDN_ORIGIN=
MEDIA_CDN_AUTH_KEY=
# CDN Type A expiry must be configured to exactly 60 seconds; authenticate cache hits.

# 内部预算：空值采用配置模块唯一默认值，单位显式区分；不改变资金额度。
INTERNAL_DAILY_SUMMARY_WARN_TOKENS=
INTERNAL_DAILY_SUMMARY_HARD_TOKENS=
INTERNAL_TREND_WARN_TOKENS=
INTERNAL_TREND_HARD_TOKENS=
INTERNAL_EVIDENCE_WARN_TOKENS=
INTERNAL_EVIDENCE_HARD_TOKENS=
INTERNAL_SOURCE_CHARACTER_MAX=
INTERNAL_MINIMUM_REFERENCES=
INTERNAL_PROMPT_HARD_BYTES=

# 认证准入：启动时读取；不支持 0 绕过。来源由受信代理解析，不记录明文。
AUTH_GLOBAL_RATE_PER_SECOND=8
AUTH_GLOBAL_BURST=16
AUTH_IP_RATE_PER_MINUTE=30
AUTH_IP_BURST=10
AUTH_ACCOUNT_FAILURES=8
AUTH_FAILURE_WINDOW_MS=900000
AUTH_KDF_CONCURRENCY=2
AUTH_KDF_MAX_PENDING=32
AUTH_KDF_QUEUE_TIMEOUT_MS=1000
AUTH_REQUEST_TIMEOUT_MS=5000
AUTH_FAILURE_DELAY_MS=250
AUTH_MAX_COUNTER_KEYS=10000
AUTH_COUNTER_TTL_MS=900000

# 账户恢复隔离：发布前经专项验证后启用；关闭时保持原启动失败语义。
ACCOUNT_RECOVERY_ENABLED=0
ACCOUNT_RECOVERY_CONCURRENCY=1
ACCOUNT_RECOVERY_ACCOUNT_DEADLINE_MS=30000
ACCOUNT_RECOVERY_RETRY_COOLDOWN_MS=60000
ACCOUNT_RECOVERY_DEPENDENCY_PROBE_MS=5000

# 文本AI在途/排队技术护栏（默认关闭；预算证明兼容读取与派发前取消检查始终保留）。
AI_QUEUE_ENABLED=0
AI_QUEUE_MAX_OUTSTANDING=64
AI_QUEUE_MAX_OUTSTANDING_PER_ACCOUNT=8
AI_QUEUE_MAX_PENDING_PER_GATE=64
AI_QUEUE_MAX_QUEUE_WAIT_MS=30000
AI_QUEUE_OVERLOAD_RETRY_AFTER_MS=5000

# PostgreSQL同步A阶段窄读；默认全读，metadata需同时设置账户白名单（单独*表示全部）。
PG_SYNC_READ_MODE=legacy
PG_SYNC_ACCOUNT_ALLOWLIST=

# 账户提交后提前唤醒同步等待；默认关闭，安全失效与断连清理始终保留。
SYNC_ACCOUNT_WAKE_ENABLED=0

# 思绪有界双向分页，刷新生效；默认保留旧界面。
THOUGHT_PAGING_ENABLED=0
