/**
 * 分页构建产物一致性及正式启动拒绝验收。
 * 建立时间：2026-10-19
 * 状态：active
 * 边界：只在临时制品目录注入故障，启动应在数据库和提示词装配前退出。
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import { pathToFileURL } from "node:url";
import { assertThoughtPagingBuildContract } from "../src/shared/thought-pagination/build-contract.mjs";

async function assertStartupRejects(rootDir: string) {
  const foundationUrl = pathToFileURL(path.resolve("src/app/runtime-foundation.mjs")).href;
  const entryUrl = pathToFileURL(path.join(rootDir, "server.mjs")).href;
  const code = `
    const { createRuntimeFoundation } = await import(${JSON.stringify(foundationUrl)});
    try {
      await createRuntimeFoundation({ rootUrl: new URL(${JSON.stringify(entryUrl)}), accountAccess: {} });
      process.exitCode = 2;
    } catch (error) {
      if (error.code !== "THOUGHT_PAGING_CONFIG_MISMATCH") throw error;
      console.log(error.code);
    }
  `;
  const result = spawnSync(process.execPath, ["--input-type=module", "--eval", code], {
    encoding: "utf8",
    timeout: 10000,
    env: {
      ...process.env,
      LOCAL_TEST_MODE: "0",
      AUTH_REQUIRED: "1",
      INVITE_CODE_HASH: "0".repeat(64),
      THOUGHT_PAGING_ENABLED: "1"
    }
  });
  assert.equal(result.status, 0, result.stderr);
  assert.match(result.stdout, /THOUGHT_PAGING_CONFIG_MISMATCH/u);
}

/** 使用真实编译文件与正式 foundation 验证同源、容量变更、缺失和不匹配。 @since unreleased */
export async function runThoughtPagingBuildChecks() {
  const temporary = await mkdtemp(path.join(os.tmpdir(), "for-now-thought-build-"));
  const backend = path.join(temporary, ".build/typescript/backend/shared/thought-pagination/index.mjs");
  const frontend = path.join(temporary, "public/generated/thought-pagination-config.mjs");
  try {
    await mkdir(path.dirname(backend), { recursive: true });
    await mkdir(path.dirname(frontend), { recursive: true });
    await writeFile(path.join(temporary, "package.json"), JSON.stringify({ version: "fixture" }));
    const source = await readFile(".build/typescript/backend/shared/thought-pagination/index.mjs", "utf8");
    const generated = await readFile("public/generated/thought-pagination-config.mjs", "utf8");
    assert.equal(source, generated);
    await writeFile(backend, source);
    await writeFile(frontend, source);
    await assertThoughtPagingBuildContract(temporary);
    const changed = source.replace("pageSize: 20", "pageSize: 19");
    assert.notEqual(changed, source);
    await writeFile(backend, changed);
    await assert.rejects(assertThoughtPagingBuildContract(temporary), { code: "THOUGHT_PAGING_CONFIG_MISMATCH" });
    await assertStartupRejects(temporary);
    await writeFile(frontend, changed);
    await assertThoughtPagingBuildContract(temporary);
    await rm(frontend);
    await assert.rejects(assertThoughtPagingBuildContract(temporary), { code: "THOUGHT_PAGING_CONFIG_MISMATCH" });
    await assertStartupRejects(temporary);
    console.log("Thought paging build passed: shared generated bytes, changed capacity parity, mismatch/missing artifact reject formal startup before database access.");
  } finally {
    await rm(temporary, { recursive: true, force: true });
  }
}
